# Postgres connection string (Neon / Vercel Postgres).
# Leave empty for local dev: Brieflet falls back to an embedded PGlite database in ./.pglite
DATABASE_URL=

# Secret for the MCP endpoint (/api/mcp/<MCP_SECRET>) and REST endpoint (Bearer token).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_SECRET=change-me-to-a-long-random-string

# Public URL of the site, used for links returned by save_brief and OpenGraph tags.
# Optional on Vercel (falls back to VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
